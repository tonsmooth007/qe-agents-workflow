# Copy to .claude/.env (git-ignored) and fill in. Never commit real values.
# The helper scripts load it automatically, and Robot runs started by run_robot.py inherit these variables.

# Jira Cloud — API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=you@your-company.com
JIRA_API_TOKEN=

# Zephyr Scale Cloud — Jira > Apps > Zephyr > (profile) > Zephyr API keys
ZEPHYR_API_TOKEN=

# GitLab — personal/project access token with "api" scope
GITLAB_URL=https://gitlab.your-company.com
GITLAB_TOKEN=

# RBAC test credentials do NOT go here. They live in the test repo's root .env as
# COMS_<ROLE>_USERNAME / COMS_<ROLE>_PASSWORD (see README, "Test credentials").
